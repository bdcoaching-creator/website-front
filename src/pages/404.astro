---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer)." noindex>
  <section class="section">
    <div class="container prose">
      <span class="eyebrow">404</span>
      <h1>Deze pagina bestaat niet (meer)</h1>
      <p>Misschien is de pagina verplaatst of is de link niet helemaal goed.</p>
      <div class="btn-row">
        <a class="btn" href="/">Naar de homepage</a>
        <a class="btn btn--ghost" href="/diensten">Bekijk de diensten</a>
      </div>
    </div>
  </section>
</BaseLayout>
