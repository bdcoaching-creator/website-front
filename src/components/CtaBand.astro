---
interface Props {
  titel: string;
  tekst: string;
  knop: string;
  href: string;
}
const { titel, tekst, knop, href } = Astro.props;
---

<section class="section section--dark cta-band">
  <div class="cta-band__strepen" aria-hidden="true"></div>
  <div class="container cta-band__inner">
    <div data-reveal>
      <h2>{titel}</h2>
      <p>{tekst}</p>
    </div>
    <div data-reveal style="--i:1">
      <a class="btn btn--light cta-band__knop" href={href}>{knop} <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    overflow: hidden;
  }
  .cta-band__strepen {
    position: absolute;
    inset: 0;
    color: var(--cream);
    background: repeating-linear-gradient(-60deg, currentColor 0 2px, transparent 2px 26px);
    opacity: 0.07;
    mask-image: linear-gradient(90deg, transparent, #000 70%);
  }
  .cta-band__inner {
    position: relative;
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
    }
  }
  .cta-band h2 {
    color: var(--cream);
    max-width: 40rem;
  }
  .cta-band p {
    color: rgb(243 228 210 / 0.88);
    max-width: 40rem;
    margin: 0;
    font-size: 1.1rem;
  }
  .cta-band__knop {
    font-size: 1.05rem;
    min-height: 3.5rem;
    padding-inline: 1.75rem;
  }
</style>
