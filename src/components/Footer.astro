---
import Logo from "./Logo.astro";
import site from "../data/site.json";
import { getDiensten, dienstUrl } from "../lib/diensten";

const diensten = await getDiensten();
const jaar = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__logo" data-reveal>
      <Logo variant="gradient-light" />
    </div>

    <div class="site-footer__grid">
      <div>
        <p class="site-footer__tagline">{site.tagline}</p>
        <ul class="site-footer__badges" aria-label="Registraties">
          <li>Geregistreerd arbeidsdeskundige (SRA)</li>
          <li>Lid NVvA</li>
          <li>Erkend jobcoach</li>
        </ul>
      </div>

      <div>
        <h2 class="site-footer__title">Diensten</h2>
        <ul class="site-footer__links">
          {diensten.map((d) => <li><a href={dienstUrl(d.id)}>{d.data.titel}</a></li>)}
          <li><a href="/tarieven">Tarieven</a></li>
        </ul>
      </div>

      <div>
        <h2 class="site-footer__title">Tools</h2>
        <ul class="site-footer__links">
          <li><a href="/tools/poortwachter-tijdlijn">Poortwachter-tijdlijn</a></li>
          <li><a href="/tools/verzuimkosten-calculator">Verzuimkosten-calculator</a></li>
        </ul>
        <h2 class="site-footer__title site-footer__title--spaced">Contact</h2>
        <address class="site-footer__address">
          {site.adres.straat}<br />
          {site.adres.postcode} {site.adres.plaats}<br />
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          {site.telefoon}
        </address>
      </div>

      <div>
        <h2 class="site-footer__title">Gegevens</h2>
        <ul class="site-footer__links">
          <li>KvK: {site.kvk}</li>
          <li>Btw: {site.btw}</li>
          <li><a href="/privacyverklaring">Privacyverklaring</a></li>
          <li><a href="/cookieverklaring">Cookieverklaring</a></li>
          <li><a href="/algemene-voorwaarden">Algemene voorwaarden</a></li>
          <li><a href="/klachtenregeling">Klachtenregeling</a></li>
        </ul>
      </div>
    </div>

    <p class="site-footer__bottom">
      © {jaar} {site.bedrijfsnaam}. Deze website gebruikt geen tracking-cookies.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgb(243 228 210 / 0.85);
    padding-block: 4rem 2rem;
    font-size: 0.975rem;
  }
  .site-footer a {
    color: var(--cream);
  }
  .site-footer__logo {
    max-width: 44rem;
    margin-bottom: 3.5rem;
  }
  .site-footer__grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }
  .site-footer__tagline {
    max-width: 22rem;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--cream);
  }
  .site-footer__title {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage-light);
    margin-bottom: 0.75rem;
  }
  .site-footer__title--spaced {
    margin-top: 1.75rem;
  }
  .site-footer__links,
  .site-footer__badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .site-footer__badges li {
    font-size: 0.9rem;
  }
  .site-footer__badges li::before {
    content: "✓ ";
    color: var(--sage-light);
  }
  .site-footer__address {
    font-style: normal;
  }
  .site-footer__bottom {
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(243 228 210 / 0.15);
    font-size: 0.875rem;
    color: rgb(243 228 210 / 0.7);
  }
</style>
