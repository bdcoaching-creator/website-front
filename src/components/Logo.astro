---
import { LOGO_LETTERS, LOGO_VIEWBOX } from "../lib/logo";

interface Props {
  /** Kleurvariant uit de huisstijl. */
  variant?: "green" | "cream" | "ink" | "gradient" | "gradient-light";
  /** Letters schuiven bij het laden in elkaar. */
  animate?: boolean;
  /** Letters maken een golfje bij hover (header). */
  wave?: boolean;
  class?: string;
  title?: string;
}

const { variant = "green", animate = false, wave = false, class: className, title = "AdaptXS" } = Astro.props;
const gradientId = `logo-grad-${Math.random().toString(36).slice(2, 8)}`;
const isGradient = variant.startsWith("gradient");
const fill = isGradient ? `url(#${gradientId})` : "currentColor";
---

<svg
  class:list={["logo", `logo--${variant}`, { "logo--animate": animate, "logo--wave": wave }, className]}
  viewBox={LOGO_VIEWBOX}
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  {
    isGradient && (
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="0.15" gradientUnits="objectBoundingBox">
          {variant === "gradient" ? (
            <>
              <stop offset="0" stop-color="#0c6d45" />
              <stop offset="0.55" stop-color="#7a9474" />
              <stop offset="1" stop-color="#c9c4b1" />
            </>
          ) : (
            <>
              <stop offset="0" stop-color="#f3e4d2" />
              <stop offset="0.6" stop-color="#a8b098" />
              <stop offset="1" stop-color="#7a9474" />
            </>
          )}
        </linearGradient>
      </defs>
    )
  }
  <g fill={fill} fill-rule="evenodd">
    {LOGO_LETTERS.map((d, i) => <path class="logo__l" style={`--i:${i}`} d={d} />)}
  </g>
</svg>

<style>
  .logo {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .logo--green {
    color: var(--green);
  }
  .logo--cream {
    color: var(--cream);
  }
  .logo--ink {
    color: var(--ink);
  }

  .logo__l {
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  /* Intro: letters schuiven als losse strepen in elkaar (om en om van boven/onder). */
  .logo--animate .logo__l {
    animation: logo-in 1.1s var(--ease) both;
    animation-delay: calc(0.15s + var(--i) * 0.09s);
  }
  .logo--animate .logo__l:nth-child(even) {
    animation-name: logo-in-up;
  }
  @keyframes logo-in {
    from {
      opacity: 0;
      transform: translateY(-60%) skewX(-12deg);
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes logo-in-up {
    from {
      opacity: 0;
      transform: translateY(60%) skewX(12deg);
      clip-path: inset(100% 0 0 0);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 0 0);
    }
  }

  /* Golfje bij hover in de header. */
  :global(a:hover) > .logo--wave .logo__l,
  .logo--wave:hover .logo__l {
    animation: logo-wave 0.6s var(--ease);
    animation-delay: calc(var(--i) * 0.05s);
  }
  @keyframes logo-wave {
    40% {
      transform: translateY(-14%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo__l {
      animation: none !important;
    }
  }
</style>
