---
import Basis from "../layouts/Basis.astro";
import Formulier from "../components/contact/Formulier.astro";
import site from "../data/site.json";

// [NOG TE CONTROLEREN] Contactgegevens zijn nog leeg; ze verschijnen pas als ze in site.json staan.
const { email, telefoon } = site.contact;
---

<Basis
  titel="Contact"
  beschrijving="Neem contact op met Arbeidswaarde over een screening voor de Eerstejaars Ziektewetbeoordeling, of vraag een afspraak aan."
>
  <section class="contact" aria-labelledby="contact-titel">
    <div class="container">
      <h1 id="contact-titel">Neem contact op</h1>
      <p class="inleiding">
        Heeft u een dossier dat de 44 weken nadert, of wilt u weten of de screening bij uw organisatie past? Stuur
        ons een bericht of vraag een afspraak aan.
      </p>

      <div class="contact__raster">
        <aside class="contact__afspraak" aria-labelledby="afspraak-titel">
          <h2 id="afspraak-titel">Liever eerst praten?</h2>
          <p>Vraag een afspraak aan. Wij nemen contact met u op om samen een moment te kiezen.</p>
          <a href="#formulier" class="knop knop--primair" data-afspraak>Maak een afspraak</a>
        </aside>

        <div class="contact__formulier">
          <Formulier />
        </div>

        <aside class="contact__na" aria-labelledby="na-titel">
          <h2 id="na-titel">Wat er na uw bericht gebeurt</h2>
          <ol class="contact__stappen">
            <li>Een arbeidsdeskundige leest uw bericht.</li>
            <li>Wij nemen contact met u op, per e-mail of telefoon.</li>
            <li>Samen bekijken we of een screening zinvol is.</li>
          </ol>

          {
            (email || telefoon) && (
              <>
                <h2 class="contact__kop-klein">Direct contact</h2>
                <ul class="contact__gegevens">
                  {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
                  {telefoon && <li><a href={`tel:${telefoon.replace(/\s/g, "")}`}>{telefoon}</a></li>}
                </ul>
              </>
            )
          }
        </aside>
      </div>
    </div>
  </section>
</Basis>

<script>
  import "../scripts/contact.ts";
</script>

<style>
  .contact {
    padding-block: clamp(2.5rem, 1rem + 6vw, 6rem) var(--ruimte-sectie);
  }
  .contact h1 {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 4rem);
  }
  /* Volgorde in de code = volgorde op mobiel: afspraak, formulier, wat er daarna gebeurt. Breed: formulier links. */
  .contact__raster {
    display: grid;
    grid-template-areas: "afspraak" "formulier" "na";
    gap: var(--ruimte-7);
    margin-top: var(--ruimte-7);
    align-items: start;
  }
  .contact__formulier {
    grid-area: formulier;
  }
  .contact__afspraak {
    grid-area: afspraak;
  }
  .contact__na {
    grid-area: na;
  }
  .contact__afspraak h2,
  .contact__na h2 {
    font-size: var(--kop-3);
    margin-bottom: var(--ruimte-2);
  }
  .contact__na,
  .contact__na .contact__kop-klein {
    padding-top: var(--ruimte-5);
    border-top: 1px solid var(--kleur-lijn);
  }
  .contact__na .contact__kop-klein {
    margin-top: var(--ruimte-6);
  }
  .contact__stappen {
    display: grid;
    gap: var(--ruimte-2);
    margin: var(--ruimte-3) 0 0;
    padding-left: 1.3rem;
  }
  .contact__stappen li::marker {
    font-family: var(--font-kop);
    color: var(--kleur-dennengroen);
  }
  .contact__gegevens {
    display: grid;
    gap: var(--ruimte-2);
    margin: var(--ruimte-3) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 60rem) {
    .contact__raster {
      grid-template-columns: 7fr 4fr;
      grid-template-areas: "formulier afspraak" "formulier na";
      grid-template-rows: auto 1fr;
      gap: var(--ruimte-6) var(--ruimte-8);
    }
  }
</style>
