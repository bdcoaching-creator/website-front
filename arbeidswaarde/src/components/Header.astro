---
import Logo from "./Logo.astro";
import site from "../data/site.json";

const pad = Astro.url.pathname.replace(/\/?$/, "/");
const isHuidig = (href: string) => (href === "/" ? pad === "/" : pad.startsWith(href));
---

<header class="kop" data-kop>
  <div class="container kop__binnen">
    <a href="/" class="kop__logo" aria-label="Arbeidswaarde, naar de homepage">
      <Logo />
    </a>

    <nav class="pil" aria-label="Hoofdmenu" data-pil>
      <button class="pil__knop" type="button" aria-expanded="false" aria-controls="hoofdmenu" data-pil-knop>
        <span>Menu</span>
        <svg class="pil__icoon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
      <ul class="pil__lijst" id="hoofdmenu" data-pil-lijst>
        {
          site.navigatie.map((item) => (
            <li>
              <a href={item.href} class="pil__link" aria-current={isHuidig(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="pil__actie-mobiel">
          <a href="/contact/" class="knop knop--primair">Neem contact op</a>
        </li>
      </ul>
    </nav>

    <a href="/contact/" class="knop knop--primair kop__actie">Neem contact op</a>
  </div>
</header>

<script>
  const pil = document.querySelector<HTMLElement>("[data-pil]");
  const knop = document.querySelector<HTMLButtonElement>("[data-pil-knop]");
  const kop = document.querySelector<HTMLElement>("[data-kop]");

  if (pil && knop) {
    const zet = (open: boolean, focusTerug = false) => {
      knop.setAttribute("aria-expanded", String(open));
      pil.classList.toggle("is-open", open);
      if (!open && focusTerug) knop.focus();
    };

    knop.addEventListener("click", () => zet(knop.getAttribute("aria-expanded") !== "true"));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && pil.classList.contains("is-open")) zet(false, true);
    });

    document.addEventListener("click", (e) => {
      if (pil.classList.contains("is-open") && !pil.contains(e.target as Node)) zet(false);
    });

    // Focus die het menu verlaat (bijv. met Tab), sluit het menu.
    pil.addEventListener("focusout", (e) => {
      const naar = e.relatedTarget as Node | null;
      if (naar && !pil.contains(naar)) zet(false);
    });

    matchMedia("(min-width: 60rem)").addEventListener("change", () => zet(false));
  }

  // Lichte schaduw onder de header zodra de pagina gescrold is.
  if (kop) {
    const markeer = () => kop.classList.toggle("is-gescrold", window.scrollY > 8);
    markeer();
    window.addEventListener("scroll", markeer, { passive: true });
  }
</script>

<style>
  .kop {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(247 244 239 / 0.92);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duur-m) var(--curve);
  }
  .kop.is-gescrold {
    border-bottom-color: var(--kleur-lijn);
  }
  .kop__binnen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ruimte-4);
    min-height: 4.5rem;
  }
  .kop__logo {
    display: inline-flex;
    text-decoration: none;
    border-radius: var(--hoek-s);
  }

  /* Pil: op mobiel een knop met uitklapmenu, vanaf 960 pixels een pil met de links erin. */
  .pil {
    position: relative;
  }
  .pil__knop {
    display: inline-flex;
    align-items: center;
    gap: var(--ruimte-2);
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    background: var(--kleur-wit);
    color: var(--kleur-dennengroen);
    border: 1px solid var(--kleur-lijn);
    border-radius: var(--hoek-pil);
    font: 600 0.9375rem/1 var(--font-tekst);
    cursor: pointer;
  }
  .pil__icoon path {
    transition: d var(--duur-m) var(--curve);
  }
  .pil.is-open .pil__icoon path {
    d: path("M6 6l12 12M6 18L18 6");
  }
  .pil__lijst {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pil__link {
    display: block;
    color: var(--kleur-antraciet);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--hoek-pil);
    transition:
      background-color var(--duur-kort) var(--curve),
      color var(--duur-kort) var(--curve);
  }
  .pil__link:hover {
    background: var(--kleur-salie-zacht);
    color: var(--kleur-dennengroen);
  }
  .pil__link[aria-current="page"] {
    background: var(--kleur-dennengroen);
    color: var(--kleur-beige);
  }

  /* Zonder JavaScript staat het menu gewoon open. */
  :global(html:not(.js)) .pil__knop {
    display: none;
  }

  @media (max-width: 59.99rem) {
    .kop__actie {
      display: none;
    }
    :global(html.js) .pil__lijst {
      position: absolute;
      top: calc(100% + 0.75rem);
      right: 0;
      width: min(20rem, calc(100vw - 2 * var(--gutter)));
      padding: var(--ruimte-3);
      background: var(--kleur-wit);
      border: 1px solid var(--kleur-lijn);
      border-radius: var(--hoek-m);
      box-shadow: var(--schaduw-zacht);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition:
        opacity var(--duur-kort) var(--curve),
        transform var(--duur-kort) var(--curve),
        visibility 0s linear var(--duur-kort);
    }
    :global(html.js) .pil.is-open .pil__lijst {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity var(--duur-kort) var(--curve),
        transform var(--duur-kort) var(--curve);
    }
    .pil__link {
      padding: 0.75rem 1rem;
      border-radius: var(--hoek-s);
    }
    .pil__actie-mobiel {
      margin-top: var(--ruimte-2);
      padding-top: var(--ruimte-3);
      border-top: 1px solid var(--kleur-lijn);
    }
    .pil__actie-mobiel .knop {
      width: 100%;
    }
  }

  @media (min-width: 60rem) {
    .pil__knop,
    .pil__actie-mobiel {
      display: none;
    }
    .pil__lijst {
      display: flex;
      gap: var(--ruimte-1);
      padding: 0.3rem;
      background: var(--kleur-wit);
      border: 1px solid var(--kleur-lijn);
      border-radius: var(--hoek-pil);
    }
    .pil__link {
      padding: 0.55rem 1.1rem;
      font-size: 0.9375rem;
    }
  }
</style>
