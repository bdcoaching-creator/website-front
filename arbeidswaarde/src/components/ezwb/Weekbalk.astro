---
/**
 * Weekbalk van week 0 tot 104 met het venster van week 44 tot 54.
 * De balk zelf is decoratief (aria-hidden); de betekenis staat in de lijst eronder.
 * Vult zich bij scrollen op breed scherm; op mobiel en bij prefers-reduced-motion direct vol.
 */
import ezwb from "../../data/ezwb.json";

const { titel, tekst, markeringen } = ezwb.weken;
const pct = (week: number) => `${(week / 104) * 100}%`;
const nummers = [0, 44, 52, 104];
---

<section class="weken sectie" aria-labelledby="weken-titel">
  <div class="container">
    <h2 id="weken-titel">{titel}</h2>
    <p class="inleiding">{tekst}</p>

    <div class="balk" data-weekbalk aria-hidden="true">
      <div class="balk__venster" style={`left:${pct(44)};width:calc(${pct(54)} - ${pct(44)})`}>
        <span>Venster week 44 tot 54</span>
      </div>
      <div class="balk__spoor">
        <div class="balk__vulling" data-weekbalk-vulling></div>
      </div>
      {markeringen.map((m) => <span class="balk__streep" style={`left:${pct(m.week)}`} />)}
      <div class="balk__nummers">
        {
          nummers.map((n) => (
            <span class:list={["balk__nummer", { "balk__nummer--klein": n === 44 }]} style={`left:${pct(n)}`}>
              {n}
            </span>
          ))
        }
      </div>
    </div>

    <ol class="weken__lijst">
      {
        markeringen.map((m) => (
          <li class:list={["weken__item", { "weken__item--venster": m.week >= 44 && m.week <= 54 }]}>
            <span class="weken__week">Week {m.week}</span>
            <h3>{m.titel}</h3>
            <p>{m.tekst}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .weken h2 {
    max-width: 20ch;
  }
  .balk {
    position: relative;
    margin: var(--ruimte-8) 0 var(--ruimte-7);
    padding-top: 2.25rem;
  }
  .balk__venster {
    position: absolute;
    top: 0;
    height: 2.25rem;
    border: 2px solid var(--kleur-terracotta);
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
  }
  .balk__venster span {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--kleur-dennengroen);
  }
  .balk__spoor {
    position: relative;
    height: 14px;
    overflow: hidden;
    border-radius: var(--hoek-pil);
    background: var(--kleur-salie-zacht);
  }
  .balk__vulling {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--kleur-dennengroen);
    transform-origin: left center;
  }
  .balk__streep {
    position: absolute;
    top: calc(2.25rem - 4px);
    width: 2px;
    height: 22px;
    margin-left: -1px;
    background: var(--kleur-antraciet);
  }
  .balk__nummers {
    position: relative;
    height: 1.5rem;
    margin-top: 0.75rem;
  }
  .balk__nummer {
    position: absolute;
    transform: translateX(-50%);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .balk__nummer:first-child {
    transform: none;
  }
  .balk__nummer:last-child {
    transform: translateX(-100%);
  }

  .weken__lijst {
    display: grid;
    gap: var(--ruimte-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .weken__item {
    padding-top: var(--ruimte-4);
    border-top: var(--lijn-dun) solid var(--kleur-saliegroen);
  }
  .weken__item--venster {
    border-top-color: var(--kleur-terracotta);
  }
  .weken__week {
    font-family: var(--font-kop);
    font-variant-numeric: lining-nums;
    font-size: 1.125rem;
    color: var(--kleur-dennengroen);
  }
  .weken__item h3 {
    margin: var(--ruimte-1) 0 var(--ruimte-2);
    font-family: var(--font-tekst);
    font-size: 1rem;
    font-weight: 600;
  }
  .weken__item p {
    margin: 0;
    font-size: var(--tekst-s);
  }
  @media (max-width: 47.99rem) {
    .balk__nummer--klein {
      display: none;
    }
  }
  @media (min-width: 48rem) {
    .weken__lijst {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
