---
/**
 * Cijfers van UWV met bron en periode. Een cijfer verschijnt alleen als het in ezwb.json
 * op gecontroleerd: true staat. In een conceptbuild (PUBLIC_CONCEPT=1) verschijnen ook
 * ongecontroleerde cijfers, met een zichtbare markering, om de vormgeving te kunnen beoordelen.
 * Zijn er geen cijfers om te tonen, dan verschijnt de sectie niet.
 */
import ezwb from "../../data/ezwb.json";

const concept = import.meta.env.PUBLIC_CONCEPT === "1";
const { titel, tekst, items } = ezwb.cijfers;
const zichtbaar = items.filter((i) => i.gecontroleerd || concept);
const bron = (id: string) => ezwb.bronnen.find((b) => b.id === id);
const nl = (n: number) => n.toLocaleString("nl-NL");
---

{
  zichtbaar.length > 0 && (
    <section class="cijfers sectie" aria-labelledby="cijfers-titel">
      <div class="container">
        <h2 id="cijfers-titel">{titel}</h2>
        <p class="inleiding">{tekst}</p>
        <dl class="cijfers__lijst">
          {zichtbaar.map((c) => (
            <div class="cijfer">
              <dt class="cijfer__getal">
                {c.voorvoegsel && <span class="cijfer__voor">{c.voorvoegsel} </span>}
                <span class="visueel-verborgen">{nl(c.waarde)}</span>
                <span data-teller={c.waarde} aria-hidden="true">{nl(c.waarde)}</span>
              </dt>
              <dd>
                <span class="cijfer__label">{c.label}</span>
                <span class="cijfer__bron">
                  {c.periode}. Bron: <a href={`#bron-${c.bron}`}>{bron(c.bron)?.uitgever}</a>
                </span>
                {!c.gecontroleerd && <span class="cijfer__concept">Nog te controleren</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<style>
  .cijfers {
    background: var(--kleur-wit);
  }
  .cijfers h2 {
    max-width: 20ch;
  }
  .cijfers__lijst {
    display: grid;
    gap: var(--ruimte-6);
    margin: var(--ruimte-7) 0 0;
  }
  .cijfer {
    padding-top: var(--ruimte-5);
    border-top: var(--lijn-dun) solid var(--kleur-dennengroen);
  }
  .cijfer__getal {
    font-family: var(--font-kop);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    line-height: 1;
    color: var(--kleur-dennengroen);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .cijfer__voor {
    font-size: 0.45em;
  }
  .cijfer dd {
    display: grid;
    gap: var(--ruimte-2);
    margin: var(--ruimte-4) 0 0;
  }
  .cijfer__label {
    font-weight: 600;
  }
  .cijfer__bron {
    font-size: 0.875rem;
  }
  .cijfer__concept {
    justify-self: start;
    padding: 0.15rem 0.6rem;
    border: 1.5px dashed var(--kleur-dennengroen);
    border-radius: var(--hoek-s);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--kleur-dennengroen);
  }
  @media (min-width: 48rem) {
    .cijfers__lijst {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
