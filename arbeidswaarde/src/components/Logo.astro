---
/**
 * [NOG TE CONTROLEREN] Tijdelijk logo: het beeldmerk is nagetekend van het merkbord (Concept 3).
 * Vervangen door het definitieve SVG-bestand zodra dat is aangeleverd.
 */
interface Props {
  variant?: "licht" | "donker";
  ondertitel?: boolean;
}
const { variant = "licht", ondertitel = false } = Astro.props;
const groen = variant === "licht" ? "#0E3A2F" : "#F7F4EF";
---

<span class:list={["logo", `logo--${variant}`]}>
  <svg class="logo__beeld" viewBox="0 0 100 80" width="44" height="35" aria-hidden="true" focusable="false">
    <path fill={groen} d="M4 78 L41 3 H59 L28 78 Z"></path>
    <path fill="#6A8F6F" d="M59 3 L83 52 C76 45 66 41 55 41 C51 41 47 42 44 43 Z"></path>
    <path fill="#D37A5A" d="M36 78 C38 58 50 47 66 47 C76 47 83 51 87 56 L98 78 H81 C77 66 71 60 63 60 C55 60 50 67 49 78 Z"></path>
  </svg>
  <span class="logo__tekst">
    <span class="logo__naam">Arbeidswaarde</span>
    {ondertitel && <span class="logo__belofte">Deskundig in arbeid, gericht op resultaat.</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .logo__beeld {
    flex: none;
  }
  .logo__tekst {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .logo__naam {
    font-family: var(--font-kop);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--kleur-dennengroen);
  }
  .logo__belofte {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .logo--donker .logo__naam,
  .logo--donker .logo__belofte {
    color: var(--kleur-beige);
  }
  @media (max-width: 400px) {
    .logo__naam {
      font-size: 1.1rem;
    }
  }
</style>
