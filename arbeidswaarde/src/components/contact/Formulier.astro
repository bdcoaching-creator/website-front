---
/**
 * Contactformulier. Validatie in de browser (src/scripts/contact.ts) en op de server (public/api/contact.php).
 * Zonder JavaScript werkt het ook: de server stuurt dan door naar /contact/verzonden/ of toont een foutpagina.
 * "Verzonden" verschijnt alleen als de server dat bevestigt.
 */
import site from "../../data/site.json";

const { email } = site.contact;
---

<div class="formulier-blok">
  <form
    id="formulier"
    class="formulier"
    action="/api/contact.php"
    method="post"
    novalidate
    data-formulier
    data-fout-email={email}
    aria-labelledby="formulier-titel"
  >
    <h2 id="formulier-titel">Stuur ons een bericht</h2>
    <p class="formulier__intro">Alle velden zijn verplicht, behalve uw telefoonnummer.</p>

    <input type="hidden" name="onderwerp" value="" data-onderwerp />
    <p class="formulier__afspraak" data-afspraak-melding hidden>
      U vraagt een afspraak aan. Zet in uw bericht wanneer het u uitkomt.
    </p>

    <div class="veld">
      <label for="naam">Naam</label>
      <input id="naam" name="naam" type="text" autocomplete="name" required maxlength="100" aria-describedby="naam-fout" />
      <p class="veld__fout" id="naam-fout" data-fout-voor="naam" hidden></p>
    </div>

    <div class="veld">
      <label for="telefoon">Telefoonnummer <span class="veld__optioneel">(optioneel)</span></label>
      <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" aria-describedby="telefoon-fout" />
      <p class="veld__fout" id="telefoon-fout" data-fout-voor="telefoon" hidden></p>
    </div>

    <div class="veld">
      <label for="email">E-mailadres</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="150" aria-describedby="email-fout" />
      <p class="veld__fout" id="email-fout" data-fout-voor="email" hidden></p>
    </div>

    <div class="veld">
      <label for="bericht">Bericht</label>
      <p class="veld__hulp" id="bericht-hulp">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M12 7.5v5.5M12 16.2v.3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        Stuur geen medische gegevens via dit formulier.
      </p>
      <textarea id="bericht" name="bericht" rows="6" required maxlength="2000" aria-describedby="bericht-hulp bericht-fout"></textarea>
      <p class="veld__fout" id="bericht-fout" data-fout-voor="bericht" hidden></p>
    </div>

    <!-- Verborgen veld tegen spam. Mensen zien het niet; bots vullen het in. -->
    <div class="hp" aria-hidden="true">
      <label for="hp_controle">Laat dit veld leeg</label>
      <input id="hp_controle" name="hp_controle" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="formulier__melding" role="alert" data-melding hidden></div>

    <div class="formulier__verzenden">
      <button class="knop knop--primair" type="submit" data-verstuur>Verstuur bericht</button>
      <p class="formulier__privacy">
        Wat wij met uw gegevens doen, leest u in de <a href="/privacy/">privacyverklaring</a>.
      </p>
    </div>
  </form>

  <div class="bevestiging" data-bevestiging hidden>
    <h2 tabindex="-1" data-bevestiging-kop>Verzonden</h2>
    <p>Uw bericht is verstuurd. Wij nemen contact met u op via de gegevens die u heeft ingevuld.</p>
  </div>
</div>

<style>
  .formulier-blok {
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    background: var(--kleur-wit);
    border: 1px solid var(--kleur-lijn);
    border-radius: var(--hoek-l);
  }
  .formulier h2,
  .bevestiging h2 {
    font-size: var(--kop-3);
    margin-bottom: var(--ruimte-2);
  }
  .formulier__intro {
    font-size: var(--tekst-s);
  }
  .formulier__afspraak {
    padding: var(--ruimte-3) var(--ruimte-4);
    background: var(--kleur-salie-zacht);
    border-radius: var(--hoek-s);
    font-weight: 600;
    color: var(--kleur-dennengroen);
  }
  .veld {
    display: grid;
    gap: var(--ruimte-2);
    margin-top: var(--ruimte-5);
  }
  .veld label {
    font-weight: 600;
    color: var(--kleur-antraciet);
  }
  .veld__optioneel {
    font-weight: 400;
  }
  .veld input,
  .veld textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    background: var(--kleur-wit);
    border: 1.5px solid var(--kleur-rand-veld);
    border-radius: var(--hoek-s);
    color: var(--kleur-antraciet);
    font: inherit;
    transition: border-color var(--duur-kort) var(--curve);
  }
  .veld textarea {
    resize: vertical;
    min-height: 9rem;
  }
  .veld input:hover,
  .veld textarea:hover {
    border-color: var(--kleur-dennengroen);
  }
  .veld input:focus-visible,
  .veld textarea:focus-visible {
    border-color: var(--kleur-dennengroen);
    outline-offset: 2px;
  }
  .veld [aria-invalid="true"] {
    border-color: var(--kleur-fout);
    border-width: 2px;
  }
  .veld__hulp {
    display: flex;
    align-items: center;
    gap: var(--ruimte-2);
    margin: 0;
    font-size: var(--tekst-s);
    font-weight: 600;
    color: var(--kleur-dennengroen);
  }
  .veld__hulp svg {
    flex: none;
  }
  .veld__fout,
  .formulier__melding {
    margin: 0;
    font-size: var(--tekst-s);
    font-weight: 600;
    color: var(--kleur-fout);
  }
  .veld__fout::before {
    content: "Let op: ";
  }
  .formulier__melding {
    margin-top: var(--ruimte-5);
    padding: var(--ruimte-3) var(--ruimte-4);
    border: 2px solid var(--kleur-fout);
    border-radius: var(--hoek-s);
  }
  .formulier__verzenden {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ruimte-3) var(--ruimte-5);
    margin-top: var(--ruimte-6);
  }
  .formulier__verzenden .knop[aria-busy="true"] {
    opacity: 0.75;
    cursor: progress;
  }
  .formulier__privacy {
    margin: 0;
    font-size: var(--tekst-s);
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .bevestiging h2 {
    font-size: var(--kop-2);
  }
  .bevestiging h2:focus {
    outline: none;
  }
</style>
