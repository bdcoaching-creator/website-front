---
/** Dunne lijniconen (1,5 pixel), in de stijl van het merkbord. Voeg nieuwe iconen toe aan `paden`. */
interface Props {
  naam: "pijl";
  grootte?: number;
}
const { naam, grootte = 28 } = Astro.props;
const paden: Record<Props["naam"], string> = {
  pijl: "M5 12h14M13 6l6 6l-6 6",
};
---

<svg
  class="icoon"
  viewBox="0 0 24 24"
  width={grootte}
  height={grootte}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paden[naam]}></path>
</svg>
