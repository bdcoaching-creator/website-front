---
/** Tijdelijke inhoud voor pagina's die in een latere fase worden gebouwd. */
interface Props {
  label: string;
  kop: string;
  fase: string;
}
const { label, kop, fase } = Astro.props;
---

<section class="sectie">
  <div class="container">
    <span class="label">{label}</span>
    <h1>{kop}</h1>
    <p class="inleiding">Deze pagina wordt gebouwd in {fase}. Hier staat nu alleen de opzet, zodat de navigatie werkt.</p>
  </div>
</section>
