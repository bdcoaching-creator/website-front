---
/** Waarom nu: de datum van de nieuwe werkwijze van UWV als anker. [NOG TE CONTROLEREN] datum tegen uwv.nl. */
import home from "../../data/home.json";

const { datum, titel, tekst } = home.waarom;
const jaar = datum.slice(-4);
const dagMaand = datum.slice(0, -5);
---

<section class="waarom sectie op-donker" aria-labelledby="waarom-titel">
  <div class="container waarom__raster">
    <p class="waarom__datum"><time datetime="2026-11-01"><span>{dagMaand}</span> <span>{jaar}</span></time></p>
    <div class="waarom__tekst">
      <h2 id="waarom-titel">{titel}</h2>
      {tekst.map((t) => <p>{t}</p>)}
    </div>
  </div>
</section>

<style>
  .waarom {
    background: var(--kleur-dennengroen);
    color: var(--kleur-beige);
  }
  .waarom__raster {
    display: grid;
    gap: var(--ruimte-6);
  }
  .waarom__datum {
    margin: 0;
    font-family: var(--font-kop);
    font-size: clamp(3rem, 1.8rem + 4.2vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--kleur-beige);
  }
  .waarom__datum span {
    display: block;
    white-space: nowrap;
  }
  /* Korte terracotta lijn onder de datum: accent, geen tekst. */
  .waarom__datum::after {
    content: "";
    display: block;
    width: 4.5rem;
    height: 6px;
    margin-top: var(--ruimte-5);
    border-radius: 3px;
    background: var(--kleur-terracotta);
  }
  .waarom__tekst h2 {
    color: var(--kleur-beige);
    max-width: 20ch;
  }
  .waarom__tekst p {
    max-width: var(--breedte-tekst);
    font-size: var(--tekst-l);
  }
  .waarom__tekst p:last-child {
    margin-bottom: 0;
  }
  @media (min-width: 60rem) {
    .waarom__raster {
      grid-template-columns: 5fr 7fr;
      gap: var(--ruimte-8);
      align-items: start;
    }
  }
</style>
