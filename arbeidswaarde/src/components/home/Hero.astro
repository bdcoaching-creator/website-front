---
import Icoon from "../Icoon.astro";
import Route from "./Route.astro";
import home from "../../data/home.json";

const { hero } = home;
---

<section class="hero" aria-labelledby="hero-titel">
  <div class="container hero__raster">
    <div class="hero__tekst">
      <span class="label">{hero.label}</span>
      <h1 id="hero-titel">{hero.titel}</h1>
      <p class="inleiding">{hero.tekst}</p>
      <div class="hero__acties">
        <a href="/contact/" class="knop knop--primair" data-magneet>{hero.knop}</a>
        <a href="/ezwb-uitgelegd/" class="hero__link">
          {hero.link}
          <Icoon naam="pijl" grootte={18} />
        </a>
      </div>
    </div>

    <div class="hero__beeld">
      <Route />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1rem + 6vw, 6rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  .hero__raster {
    display: grid;
    gap: var(--ruimte-7);
    align-items: center;
  }
  /* Kleiner minimum dan de andere koppen: "Ziektewetbeoordeling" moet op 360 pixels passen. */
  .hero__tekst h1 {
    font-size: clamp(1.75rem, 0.9rem + 4.4vw, 4rem);
  }
  .hero__acties {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ruimte-4) var(--ruimte-6);
    margin-top: var(--ruimte-6);
  }
  .hero__link {
    display: inline-block;
    padding-block: 0.6rem;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
  }
  .hero__link :global(.icoon) {
    display: inline-block;
    margin-left: 0.35rem;
    vertical-align: -0.2em;
  }
  .hero__link:hover {
    text-decoration: underline;
  }
  .hero__link :global(.icoon) {
    transition: transform var(--duur-kort) var(--curve);
  }
  .hero__link:hover :global(.icoon) {
    transform: translateX(3px);
  }
  .hero__beeld {
    margin: 0;
    justify-self: center;
    width: min(100%, 34rem);
  }
  @media (min-width: 60rem) {
    .hero__raster {
      grid-template-columns: 1.15fr 0.85fr;
    }
    .hero__tekst h1 {
      max-width: 14ch;
    }
  }
  @media (max-width: 59.99rem) {
    .hero__beeld {
      width: min(100%, 30rem);
    }
  }
</style>
