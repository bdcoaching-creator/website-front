---
/**
 * Veelgestelde vragen als accordeon (patroon van de WAI-ARIA Authoring Practices).
 * Zonder JavaScript staan alle antwoorden open. De vragen staan ook als FAQ-markering (schema.org) in de pagina.
 */
interface Props {
  id: string;
  titel: string;
  items: { vraag: string; antwoord: string }[];
}
const { id, titel, items } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.vraag,
    acceptedAnswer: { "@type": "Answer", text: i.antwoord },
  })),
};
---

<section class="sectie sectie--vlak" aria-labelledby={id}>
  <div class="container faq">
    <h2 id={id}>{titel}</h2>
    <div class="faq__lijst" data-accordeon>
      {
        items.map((item, i) => (
          <div class="faq__item">
            <h3 class="faq__vraag">
              <button
                type="button"
                id={`${id}-knop-${i}`}
                aria-expanded="true"
                aria-controls={`${id}-antwoord-${i}`}
                data-accordeon-knop
              >
                <span>{item.vraag}</span>
                <span class="faq__teken" aria-hidden="true" />
              </button>
            </h3>
            <div id={`${id}-antwoord-${i}`} role="region" aria-labelledby={`${id}-knop-${i}`} class="faq__antwoord">
              <p>{item.antwoord}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-accordeon]").forEach((lijst) => {
    const knoppen = [...lijst.querySelectorAll<HTMLButtonElement>("[data-accordeon-knop]")];
    const zet = (knop: HTMLButtonElement, open: boolean) => {
      knop.setAttribute("aria-expanded", String(open));
      const paneel = document.getElementById(knop.getAttribute("aria-controls")!);
      if (paneel) paneel.hidden = !open;
    };
    // Met JavaScript beginnen alle vragen dicht.
    knoppen.forEach((k) => zet(k, false));

    knoppen.forEach((knop, i) => {
      knop.addEventListener("click", () => zet(knop, knop.getAttribute("aria-expanded") !== "true"));
      knop.addEventListener("keydown", (e) => {
        const doel = { ArrowDown: i + 1, ArrowUp: i - 1, Home: 0, End: knoppen.length - 1 }[e.key];
        if (doel === undefined) return;
        e.preventDefault();
        knoppen[(doel + knoppen.length) % knoppen.length].focus();
      });
    });
  });
</script>

<style>
  .sectie--vlak {
    background: var(--kleur-wit);
  }
  .faq {
    display: grid;
    gap: var(--ruimte-6);
  }
  .faq__lijst {
    border-top: 1px solid var(--kleur-lijn);
  }
  .faq__item {
    border-bottom: 1px solid var(--kleur-lijn);
  }
  .faq__vraag {
    margin: 0;
    font-family: var(--font-tekst);
    font-size: var(--tekst-m);
    font-weight: 600;
  }
  .faq__vraag button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ruimte-4);
    width: 100%;
    min-height: 3.5rem;
    padding: var(--ruimte-4) 0;
    background: none;
    border: 0;
    color: var(--kleur-dennengroen);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .faq__vraag button:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .faq__teken {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: var(--lijn-dun) solid var(--kleur-dennengroen);
    border-radius: 50%;
  }
  .faq__teken::before,
  .faq__teken::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.75rem;
    height: var(--lijn-dun);
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform var(--duur-m) var(--curve);
  }
  .faq__teken::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  [aria-expanded="true"] .faq__teken::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .faq__antwoord {
    padding-bottom: var(--ruimte-5);
    max-width: var(--breedte-tekst);
  }
  .faq__antwoord:not([hidden]) {
    animation: open var(--duur-m) var(--curve);
  }
  .faq__antwoord p {
    margin: 0;
  }
  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @media (min-width: 60rem) {
    .faq {
      grid-template-columns: 1fr 2fr;
      gap: var(--ruimte-8);
    }
  }
</style>
