---
/** Kernzin die woord voor woord van saliegroen naar dennengroen kleurt tijdens het scrollen. */
interface Props {
  tekst: string;
}
const woorden = Astro.props.tekst.split(" ");
---

<section class="kernzin" aria-label="Kernzin">
  <div class="container">
    <p class="kernzin__tekst" data-kernzin>
      {woorden.map((w, i) => <><span class="kernzin__woord">{w}</span>{i < woorden.length - 1 && " "}</>)}
    </p>
  </div>
</section>

<style>
  .kernzin {
    padding-block: var(--ruimte-sectie);
    border-block: 1px solid var(--kleur-lijn);
  }
  .kernzin__tekst {
    max-width: 22ch;
    margin: 0 auto;
    font-family: var(--font-kop);
    font-size: clamp(2rem, 1.3rem + 3.2vw, 4rem);
    line-height: 1.2;
    text-align: center;
    color: var(--kleur-dennengroen);
    text-wrap: balance;
  }
  /* Saliegroen haalt 3,3:1 op beige: voldoende voor tekst van deze grootte. */
  :global(html.js) .kernzin__tekst[data-actief] .kernzin__woord {
    color: var(--kleur-saliegroen);
    transition: color var(--duur-m) var(--curve);
  }
  :global(html.js) .kernzin__tekst[data-actief] .kernzin__woord.is-aan {
    color: var(--kleur-dennengroen);
  }
</style>
